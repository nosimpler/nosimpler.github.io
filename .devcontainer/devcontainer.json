{
  "name": "nosimpler.github.io Jekyll",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rebornix.Ruby",
        "Shopify.ruby-lsp",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "forwardPorts": [
    4000,
    35729
  ],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll site",
      "onAutoForward": "notify"
    },
    "35729": {
      "label": "LiveReload"
    }
  },
  "postCreateCommand": "bundle install",
  "remoteUser": "vscode"
}

