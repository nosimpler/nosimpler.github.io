#!/usr/bin/env bash
# Preview the site at http://localhost:4000 using Docker (no local Ruby needed).
# Pass "build" to build once into _site/ instead of serving.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cmd=(bundle exec jekyll serve --host 0.0.0.0 --livereload)
[[ "${1:-}" == "build" ]] && cmd=(bundle exec jekyll build)
docker run --rm -it -p 4000:4000 -p 35729:35729 \
  -v "$root":/site -w /site \
  -v nosimpler-site-gems:/usr/local/bundle \
  ruby:3.2-bookworm \
  bash -c "bundle install --quiet && ${cmd[*]}"
